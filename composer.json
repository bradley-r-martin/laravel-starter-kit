{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nunomaduro/laravel-starter-kit",
    "type": "project",
    "version": "0.0.0",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.0",
        "aws/aws-sdk-php": "^3.363",
        "inertiajs/inertia-laravel": "^2.0",
        "inertiaui/modal": "^0.21.1",
        "laravel-notification-channels/webpush": "^10.2",
        "laravel/framework": "^12.38.1",
        "laravel/octane": "^2.13",
        "league/flysystem-aws-s3-v3": "^3.0",
        "nunomaduro/essentials": "^1.0.1",
        "rlanvin/php-rrule": "^2.6",
        "spatie/laravel-event-sourcing": "^7.12",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.7.2",
        "laravel/boost": "^1.2.1",
        "laravel/pail": "^1.2.3",
        "laravel/pint": "^1.25.1",
        "laravel/telescope": "^5.13",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.2",
        "pestphp/pest": "4.x-dev",
        "pestphp/pest-plugin-browser": "^4.1.1",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0.3",
        "rector/rector": "^2.1.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "lint": [
            "pint --parallel",
            "rector",
            "npm run lint"
        ],
        "test:type-coverage": "php -d memory_limit=512M vendor/bin/pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "npm run test:lint"
        ],
        "test:unit": "php -d memory_limit=512M vendor/bin/pest --parallel --passthru-php=\"-d memory_limit=512M\"",
        "test:types": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ],
        "migrate:download": "php -d memory_limit=512M artisan migrate:download",
        "migrate:normalise": "php -d memory_limit=512M artisan migrate:normalise",
        "migrate:enrich": "php -d memory_limit=512M artisan migrate:enrich",
        "migrate:import": "php -d memory_limit=512M artisan migrate:import"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "bump-after-update": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
